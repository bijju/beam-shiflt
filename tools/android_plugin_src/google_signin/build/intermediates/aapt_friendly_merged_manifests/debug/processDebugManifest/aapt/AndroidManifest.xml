<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.foursagez.beamshift.googlesignin" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
     Credential Manager needs no manifest permissions or API-key metadata of its
         own (unlike the legacy Google Sign-In SDK) — it resolves the signed-in Google
         account and provider via Google Play services on the device.
    -->
    <application>

        <!--
        Plugin metadata (see addons/GodotPlayGameServices for the reference pattern):

        - The `org.godotengine.plugin.v2` prefix is required so Godot's Android plugin
        registry recognizes this AAR as a valid Godot plugin and knows which class to
        instantiate. Without this entry, the compiled class is present in the APK but
        Engine.has_singleton("GodotGoogleSignIn") never becomes true - this exact entry
        was missing and is the root cause fixed here (Phase 4A plugin-registration fix,
        2026-09-28).

        - `android:value` is the fully-qualified classpath to the plugin class.
        -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GodotGoogleSignIn"
            android:value="com.foursagez.beamshift.googlesignin.GoogleSignInPlugin" />
    </application>

</manifest>